{
  "redirects": [
    { "source": "/over", "destination": "/about", "permanent": true },
    { "source": "/toolkit/passingen", "destination": "/tools/fit-tolerances", "permanent": true },
    { "source": "/toolkit/iso-2768", "destination": "/tools/iso-2768", "permanent": true },
    {
      "source": "/toolkit/spiebaan-toleranties",
      "destination": "/tools/keyways",
      "permanent": true
    },
    {
      "source": "/toolkit/lagerpassingen",
      "destination": "/tools/bearing-fits",
      "permanent": true
    },
    {
      "source": "/toolkit/seegerring-groef",
      "destination": "/tools/seeger-grooves",
      "permanent": true
    },
    {
      "source": "/toolkit/bevestigers",
      "destination": "/tools/fasteners?model=referentie",
      "permanent": true
    },
    {
      "source": "/toolkit/o-ringgroef",
      "destination": "/tools/o-ring-grooves?model=referentie",
      "permanent": true
    },
    { "source": "/toolkit/kanten", "destination": "/tools/edges", "permanent": true },
    {
      "source": "/toolkit/motorspecificatie",
      "destination": "/calculators/motor-specification?model=referentie",
      "permanent": true
    },
    {
      "source": "/toolkit/cilinder",
      "destination": "/calculators/pneumatic-cylinder?model=referentie",
      "permanent": true
    },
    {
      "source": "/toolkit/knikberekening",
      "destination": "/calculators/buckling",
      "permanent": true
    },
    {
      "source": "/toolkit/doorbuiging-balk",
      "destination": "/calculators/beam-deflection",
      "permanent": true
    },
    { "source": "/toolkit/eenheden", "destination": "/calculators/units", "permanent": true },
    { "source": "/toolkit/bronnen", "destination": "/cad/resources", "permanent": true },
    { "source": "/toolkit/macros", "destination": "/cad/macros", "permanent": true },
    { "source": "/toolkit/koppel", "destination": "/calculators/drive-power", "permanent": true },
    {
      "source": "/toolkit/overbrenging",
      "destination": "/calculators/transmission",
      "permanent": true
    },
    { "source": "/toolkit/converter", "destination": "/calculators/units", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/tools/:slug",
      "destination": "/tools/:slug.html"
    },
    {
      "source": "/calculators/:slug",
      "destination": "/calculators/:slug.html"
    },
    {
      "source": "/cad/:slug",
      "destination": "/cad/:slug.html"
    },
    {
      "source": "/topics/:slug",
      "destination": "/topics/:slug.html"
    },
    {
      "source": "/toolkit",
      "destination": "/toolkit.html"
    },
    {
      "source": "/topics",
      "destination": "/topics.html"
    },
    {
      "source": "/cad-workflows",
      "destination": "/cad-workflows.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/tables",
      "destination": "/tables.html"
    },
    {
      "source": "/materials",
      "destination": "/materials.html"
    },
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/calculators",
      "destination": "/calculators.html"
    },
    {
      "source": "/cad",
      "destination": "/cad.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
