    },
    {
      "source": "/topics",
      "destination": "/topics.html"
    },
    {
      "source": "/cad-workflows",
      "destination": "/cad-workflows.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/tables",
      "destination": "/tables.html"
    },
    {
      "source": "/materials",
      "destination": "/materials.html"
    },
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/calculators",
      "destination": "/calculators.html"
    },
    {
      "source": "/cad",
      "destination": "/cad.html"
    },
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/en/tools/:slug",
      "destination": "/en/tools/:slug.html"
    },
    {
      "source": "/en/calculators/:slug",
      "destination": "/en/calculators/:slug.html"
    },
    {
      "source": "/en/cad/:slug",
      "destination": "/en/cad/:slug.html"
    },
    {
      "source": "/en/topics/:slug",
      "destination": "/en/topics/:slug.html"
    },
    {
      "source": "/en/toolkit",
      "destination": "/en/toolkit.html"
    },
    {
      "source": "/en/topics",
      "destination": "/en/topics.html"
    },
    {
      "source": "/en/cad-workflows",
      "destination": "/en/cad-workflows.html"
    },
    {
      "source": "/en/about",
      "destination": "/en/about.html"
    },
    {
      "source": "/en/tables",
      "destination": "/en/tables.html"
    },
    {
      "source": "/en/materials",
      "destination": "/en/materials.html"
    },
    {
      "source": "/en/tools",
      "destination": "/en/tools.html"
    },
    {
      "source": "/en/calculators",
      "destination": "/en/calculators.html"
    },
    {
      "source": "/en/cad",
      "destination": "/en/cad.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
