{
  "rewrites": [
    {
      "source": "/tools/:slug",
      "destination": "/tools/:slug.html"
    },
    {
      "source": "/calculators/:slug",
      "destination": "/calculators/:slug.html"
    },
    {
      "source": "/cad/:slug",
      "destination": "/cad/:slug.html"
    },
    {
      "source": "/topics/:slug",
      "destination": "/topics/:slug.html"
    },
    {
      "source": "/toolkit",
      "destination": "/toolkit.html"
    },
    {
      "source": "/toolkit/:slug",
      "destination": "/toolkit.html"
    },
    {
      "source": "/over",
      "destination": "/about.html"
    },
    {
      "source": "/topics",
      "destination": "/topics.html"
    },
    {
      "source": "/cad-workflows",
      "destination": "/cad-workflows.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/tables",
      "destination": "/tables.html"
    },
    {
      "source": "/materials",
      "destination": "/materials.html"
    },
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/calculators",
      "destination": "/calculators.html"
    },
    {
      "source": "/cad",
      "destination": "/cad.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
